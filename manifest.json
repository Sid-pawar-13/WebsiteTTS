{
  "manifest_version": 3,
  "name": "WebsiteTTS - Text Reader",
  "version": "1.1.0",
  "description": "Read webpages aloud with OpenAI-compatible text-to-speech, highlighting, and automatic scrolling.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Read this page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}