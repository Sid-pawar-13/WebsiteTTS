{
  "manifest_version": 3,
  "name": "WebsiteTTS - Text Reader",
  "version": "1.2.0",
  "description": "Read webpages aloud using local Ollama Phonon or an OpenAI-compatible TTS API.",
  "permissions": [
    "activeTab",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Read this page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
